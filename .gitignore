# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local data
.env
data/

# Open WebUI database backups (user accounts, chats)
backups/

# Per-company settings (SQL logins, keys) and lists (item codes): private, never committed
companies/
# Company names for the login page, written by ./company.sh (private)
webui/companies.json

# Excel downloads made by the chat (company data, deleted after 24 h)
exports/

# Sign-in accounts, session key and generated site files (company names): private, never committed
site/
