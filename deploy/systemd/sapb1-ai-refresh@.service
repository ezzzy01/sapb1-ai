[Unit]
Description=SAP B1 AI: sync B1 data and rebuild the forecast for company %i

[Service]
Type=oneshot
WorkingDirectory=%h/sapb1-ai
Environment=SAPB1_COMPANY=%i
Environment=PYTHONWARNINGS=ignore
ExecStart=%h/.local/bin/uv run --frozen python -m sapb1_ai.sync
ExecStart=%h/.local/bin/uv run --frozen python -m sapb1_ai.forecast
ExecStart=%h/.local/bin/uv run --frozen python -m sapb1_ai.alerts
ExecStart=-%h/.local/bin/uv run --frozen python -m sapb1_ai.anomalies
ExecStart=-%h/.local/bin/uv run --frozen python -m sapb1_ai.finance
ExecStart=-%h/.local/bin/uv run --frozen python -m sapb1_ai.webui
ExecStart=-%h/.local/bin/uv run --frozen python -m sapb1_ai.dashboard
ExecStart=-%h/.local/bin/uv run --frozen python -m sapb1_ai.market
