# Copy to .env and fill in. .env is git-ignored.
# SQL Server host of the B1 company database (e.g. its Tailscale IP or LAN name)
SAPB1_SQL_HOST=
SAPB1_SQL_PORT=1433
# B1 company database name; leave empty to list the databases the login can see
SAPB1_DB=
# Read-only login (db_datareader only)
SAPB1_SQL_USER=ai_reader
SAPB1_SQL_PASSWORD=

# Key Open WebUI uses to call the agent server (any long random string)
AGENT_API_KEY=

# Optional stock warnings after each nightly refresh (leave empty to turn off)
# Phone push via the ntfy app, e.g. https://ntfy.sh/<long-random-private-topic>
NTFY_URL=
# Teams / Slack / Google Chat incoming webhook
ALERT_WEBHOOK_URL=
